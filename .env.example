# Application Host URL (REQUIRED in production, must start with https://)
APP_URL="https://genovaprofile.com"

# Node Environment ('production' or 'development')
NODE_ENV="development"

# Supabase Postgres Configuration (REQUIRED in production)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Gemini API Key & Model (REQUIRED in production)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Cashfree Payment Gateway Configuration (REQUIRED in production)
# Cashfree Client ID (from Cashfree Merchant Dashboard)
CASHFREE_CLIENT_ID="your-cashfree-client-id"

# Cashfree Client Secret (CONFIDENTIAL: Strictly server-side only; NEVER expose to client)
CASHFREE_CLIENT_SECRET="your-cashfree-client-secret"

# Cashfree Environment: 'sandbox' in development; MUST be set to "production" when NODE_ENV=production
CASHFREE_ENVIRONMENT="sandbox"

# Cashfree API Version (Default: 2023-08-01)
CASHFREE_API_VERSION="2023-08-01"

# Cron Secret: Used to authorize automated retention cleanup jobs (REQUIRED in production)
CRON_SECRET="your-cron-secret-token"

# Recovery Code Pepper: Cryptographic salt for SHA-256 hashes (REQUIRED in production, no fallback)
RECOVERY_PEPPER="your-secure-random-pepper-salt"

# Retention Period for Paid Documents (in days, default 30)
PAID_DOCUMENT_RETENTION_DAYS="30"
