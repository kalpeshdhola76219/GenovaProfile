# Application Host URL (REQUIRED in production, must start with https://)
APP_URL="https://genovaprofile.com"

# Node Environment ('production' or 'development')
NODE_ENV="development"

# Supabase Postgres Configuration (REQUIRED in production)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Gemini API Key & Model (REQUIRED in production)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Razorpay Payment Gateway Configuration (REQUIRED in production)
# Razorpay Key ID (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Razorpay Key Secret (CONFIDENTIAL: Strictly server-side only; NEVER expose to client)
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Razorpay Webhook Secret (CONFIDENTIAL: Used to verify /api/webhooks/razorpay signatures)
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Cron Secret: Used to authorize automated retention cleanup jobs (REQUIRED in production)
CRON_SECRET="your-cron-secret-token"

# Recovery Code Pepper: Cryptographic salt for SHA-256 hashes (REQUIRED in production, no fallback)
RECOVERY_PEPPER="your-secure-random-pepper-salt"

# Retention Period for Paid Documents (in days, default 30)
PAID_DOCUMENT_RETENTION_DAYS="30"
